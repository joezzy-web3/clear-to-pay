{
  "name": "ctp-console-crypto",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "npm run build:crypto && npm run build:wallet",
    "build:crypto": "esbuild src/index.js --bundle --format=esm --minify --legal-comments=eof --outfile=../../docs/console/crypto.js",
    "build:wallet": "esbuild src/wallet.js --bundle --format=esm --minify --platform=browser --inject:src/node-shim.js --define:process.env.NODE_ENV='\"production\"' --define:global=globalThis --outfile=../../docs/console/wallet.js && cp node_modules/@near-wallet-selector/modal-ui/styles.css ../../docs/console/wallet.css",
    "test": "node test/check.mjs"
  },
  "devDependencies": {
    "@noble/curves": "1.9.7",
    "@noble/hashes": "1.8.0",
    "@scure/base": "1.2.6",
    "esbuild": "0.28.2",
    "qrcode-generator": "2.0.4",
    "near-api-js": "5.1.1",
    "@near-wallet-selector/core": "10.1.4",
    "@near-wallet-selector/modal-ui": "10.1.4",
    "@near-wallet-selector/my-near-wallet": "10.1.4",
    "@near-wallet-selector/meteor-wallet": "10.1.4",
    "buffer": "6.0.3",
    "process": "0.11.10",
    "util": "0.12.5"
  }
}
